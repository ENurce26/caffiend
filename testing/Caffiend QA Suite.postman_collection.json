  "item": [
    {
      "name": "Unauthenticated Read (Security Rule Test)",
      "request": {
        "method": "GET",
        "header": []
      },
      "response": []
    },
    {
      "name": "Authenticated Read",
      "request": {
        "method": "GET",
        "header": []
      },
      "response": []
    },
    {
      "name": "Add a valid drink",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Valid drink entry returns 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response contains document name\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json).to.have.property(\"name\");",
              "});",
              "",
              "// Save the new document ID for cleanup",
              "const docName = pm.response.json().name;",
              "pm.environment.set(\"last_drink_id\", docName.split(\"/\").pop());"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{id_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/users/{{user_id}}/drinks",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "users",
            "{{user_id}}",
            "drinks"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Add drink with missing required field",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Missing caffeine field is handled\", function () {",
              "    console.log(\"Response status: \" + pm.response.code);",
              "    console.log(\"Response body: \" + pm.response.text());",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 400]);",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{id_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fields\": {\n    \"name\": { \"stringValue\": \"Mystery Drink\" },\n    \"timestamp\": { \"stringValue\": \"2026-04-09T14:00:00Z\" }\n  }\n}",
          "options": {
